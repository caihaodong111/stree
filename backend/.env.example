APP_HOST=127.0.0.1
APP_PORT=8000
# 生产环境默认关闭设置 API；本地开发默认开启。
SETTINGS_ENABLED=true
# 查询阶段达到预算后转入最终输出，不会丢弃已取得的资料。
MODEL_MAX_TOOL_ROUNDS=8
MODEL_MAX_TOOL_CALLS=32
# 整个模型生成最多 10 分钟，单次接口最多等待 4 分钟。
MODEL_TIMEOUT_MS=600000
MODEL_REQUEST_TIMEOUT_MS=240000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 高德控制台申请「Web 服务」类型的 Key，保留在服务端。
AMAP_WEB_SERVICE_KEY=
AMAP_REQUEST_INTERVAL_MS=400

# 当前规划模型通过 web_search 工具检索公开网页，无需额外模型或搜索密钥。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ENDPOINT=https://www.bing.com/search
WEB_SEARCH_TIMEOUT_MS=30000

# 本机需安装并登录 Codex CLI。留空 CODEX_MODEL 使用账户的默认可用模型。
CODEX_BIN=codex
CODEX_MODEL=

# 默认使用本地文件保存行程与任务日志，无需数据库。
STORAGE_DRIVER=file
# 以下参数仅在显式选择 STORAGE_DRIVER=mysql 时使用。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stree
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_QUERY_TIMEOUT_MS=5000
# 大量坐标和攻略使用协议压缩，减少远程读写流量；本机数据库可按实测关闭。
MYSQL_COMPRESS=true
