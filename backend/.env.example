APP_HOST=127.0.0.1
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 高德控制台申请「Web 服务」类型的 Key，保留在服务端。
AMAP_WEB_SERVICE_KEY=
AMAP_REQUEST_INTERVAL_MS=400

# 本机需安装并登录 Codex CLI。留空 CODEX_MODEL 使用账户的默认可用模型。
CODEX_BIN=codex
CODEX_MODEL=
CODEX_TIMEOUT_MS=480000

# 本地开箱体验明确使用 file；正式使用可切换 mysql。
STORAGE_DRIVER=file
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stree
